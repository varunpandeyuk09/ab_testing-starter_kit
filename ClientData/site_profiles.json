{
  "praxindo": {
    "label": "PRAXINDO",
    "selectors": {
      "addToCart": [
        "#product-addtocart-button",
        ".action.tocart",
        "button[data-role=\"addtocart\"]",
        "form[data-role=\"tocart-form\"] button",
        ".box-tocart button"
      ],
      "popup": ".aw-acp-popup:has([data-role=\"update\"] .layer__checkout__title--success)",
      "popupTitle": ".aw-acp-popup:has([data-role=\"update\"] .layer__checkout__title--success) .layer__checkout__title--success",
      "update": "[data-role=\"update\"]",
      "related": "[data-role=\"related\"]",
      "relatedTitle": ".layer__checkout__upselling__title",
      "relatedTile": ".layer__checkout__upselling__list__item",
      "counter": "#minicart-counter"
    }
  },
  "revivserums": {
    "label": "REVIVSERUMS"
  },
  "pcliq": {
    "label": "PCLIQUIDATIONS",
    "selectors": {
      "counter": ".storeCartQty",
      "mobileShowMenu": ".pclBurger.mobileOnly a.mobileShowMenu",
      "stMobileMenu": "#stMobileMenu",
      "stMobileMenuInner": "#stMobileMenu .stMobileMenuInner",
      "menuHeadingSelector": "#stMobileMenu .menuHeading",
      "browseCls": ".browseMenu.pclMobileAllCats",
      "mobileBreakpoint": 800
    }
  },
  "trooper": {
    "label": "TROOPER"
  },
  "monash": {
    "label": "MONASH"
  },
  "lhlic": {
    "label": "LHLIC"
  },
  "newbalance": {
    "label": "NEWBALANCE",
    "selectors": {
      "pgpTile": ".product-grid > .pgptiles",
      "product": ".product[data-pid]",
      "tealiumData": "[data-tealium-product-tile-data]",
      "categoryName": ".product .category-name",
      "swatchSelected": "img.swatch-selected[data-color]",
      "swatchImages": "img[data-color]"
    },
    "api": {
      "nz": "https://www.newbalance.co.nz/on/demandware.store/Sites-NBNZ-Site/en_NZ/Product-Variation",
      "us": "https://www.newbalance.com/on/demandware.store/Sites-NBUS-Site/en_US/Product-Variation"
    },
    "notes": "SFCC site. dwvar_ params use double-underscore encoding (_ → __). Tealium masterProductId can be truncated — always derive pid from paramPrefix and normalize __ → _. Multiple tiles can share data-pid (colorways)."
  }
}
